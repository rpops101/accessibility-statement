{
  "name": "accessibility-statement",
  "version": "0.1.0",
  "description": "Accessibility statement generator for the European Accessibility Act. Generate an EU accessibility statement, a VPAT 2.5 / ACR conformance report (OpenACR) and an Article 14 disproportionate-burden worksheet from your axe-core, pa11y or Lighthouse results. Offline, deterministic, no signup.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "accessibility-statement": "./dist/main.js",
    "a11y-statement": "./dist/main.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node ../../scripts/run-tests.mjs test"
  },
  "dependencies": {
    "@accessibility-statement/core": "*",
    "@accessibility-statement/packs": "*"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "accessibility-statement",
    "accessibility-statement-generator",
    "a11y",
    "accessibility",
    "eaa",
    "european-accessibility-act",
    "en-301-549",
    "wcag",
    "wcag21",
    "vpat",
    "vpat-generator",
    "acr",
    "openacr",
    "compliance",
    "a11y-testing",
    "axe-core",
    "pa11y",
    "lighthouse",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rpops101/accessibility-statement.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/rpops101/accessibility-statement/issues"
  },
  "homepage": "https://github.com/rpops101/accessibility-statement#readme"
}

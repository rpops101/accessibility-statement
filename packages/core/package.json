{
  "name": "@accessibility-statement/core",
  "version": "0.1.0",
  "description": "Engine for generating EU accessibility statements and VPAT 2.5 / ACR conformance reports (OpenACR) from accessibility test evidence. WCAG to EN 301 549 mapping, one runtime dependency, no network access.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "data",
    "DEPENDENCIES.md"
  ],
  "scripts": {
    "prebuild": "node scripts/embed-data.mjs",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node ./scripts/fix-cjs.mjs",
    "pretest": "node scripts/embed-data.mjs",
    "test": "node ../../scripts/run-tests.mjs test"
  },
  "dependencies": {
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "accessibility-statement",
    "accessibility",
    "a11y",
    "eaa",
    "european-accessibility-act",
    "en-301-549",
    "wcag",
    "vpat",
    "acr",
    "openacr",
    "compliance",
    "conformance-report",
    "axe-core"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rpops101/accessibility-statement.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/rpops101/accessibility-statement/issues"
  },
  "homepage": "https://github.com/rpops101/accessibility-statement#readme"
}

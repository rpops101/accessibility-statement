{{! Canonical accessibility-statement template (FR-ART-1).
    Structure follows the model statement of Commission Implementing
    Decision (EU) 2018/1523. Logic-less: sections and variables only.
    Every label comes from the strings files, so a translated pack gets a
    fully localized statement from this template unchanged.
    The generated document must stay self-contained and axe-clean (FR-ART-6). }}<!DOCTYPE html>
<html lang="{{lang}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{t.statement.title}} — {{product.name}}</title>
<style>
:root { color-scheme: light; }
body { font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  margin: 0 auto; max-width: 52rem; padding: 1.5rem; line-height: 1.6;
  color: #1a1a1a; background: #ffffff; }
h1 { font-size: 1.6rem; line-height: 1.3; }
h2 { font-size: 1.25rem; margin-top: 2rem; }
ul { padding-left: 1.4rem; }
a { color: #084d99; }
.watermark { border: 3px dashed #8a6d00; background: #fff8e1; color: #5c4a00;
  padding: .75rem 1rem; margin: 0 0 1.5rem; font-weight: 600; }
.reviewed { border-left: 4px solid #1a6b2f; background: #f0f7f1; color: #143d1f;
  padding: .5rem 1rem; margin: 0 0 1.5rem; }
.meta { color: #444444; font-size: .9rem; }
li.criterion { margin-bottom: .5rem; }
footer { margin-top: 3rem; border-top: 1px solid #767676; padding-top: 1rem;
  color: #444444; font-size: .875rem; }
</style>
</head>
<body>
<main>
{{#draft}}<div class="watermark" role="note">{{watermark}}</div>
{{/draft}}{{^draft}}<p class="reviewed">{{t.common.reviewedBy}}: {{reviewedBy}} · {{t.common.reviewedOn}}: {{reviewedOn}}</p>
{{/draft}}<h1>{{t.statement.title}} — {{product.name}}</h1>
<p>{{org.name}}: {{t.statement.forProduct}} {{product.name}}.{{#product.scope}} {{.}}{{/product.scope}}</p>
{{#product.urls}}<p class="meta">{{url}}</p>
{{/product.urls}}
<h2>{{t.statement.complianceStatusHeading}}</h2>
{{#compliance.isFull}}<p>{{product.name}} {{t.statement.complianceSentence.full}}</p>
{{/compliance.isFull}}{{#compliance.isPartial}}<p>{{product.name}} {{t.statement.complianceSentence.partial}}</p>
{{/compliance.isPartial}}{{#compliance.isNonCompliant}}<p>{{product.name}} {{t.statement.complianceSentence.nonCompliant}}</p>
{{/compliance.isNonCompliant}}
{{#hasNonAccessible}}<h2>{{t.statement.nonAccessibleHeading}}</h2>
<p>{{t.statement.nonAccessibleIntro}}</p>
<ul>
{{#nonAccessible}}<li class="criterion">{{t.statement.criterionLabel}} {{criterion}} — {{name}} ({{statusLabel}}; {{t.statement.clauseLabel}} {{clause}}){{#messages}}<br>{{text}}{{/messages}}</li>
{{/nonAccessible}}</ul>
{{/hasNonAccessible}}
{{#burden.claimed}}<h2>{{t.statement.burdenHeading}}</h2>
<p>{{t.statement.burdenIntro}}</p>
<ul>
{{#burden.exclusions}}<li>{{scope}}{{#reason}} — {{.}}{{/reason}}</li>
{{/burden.exclusions}}</ul>
{{/burden.claimed}}
{{#hasNotEvaluated}}<h2>{{t.statement.notEvaluatedHeading}}</h2>
<p>{{t.statement.notEvaluatedIntro}}</p>
<ul>
{{#notEvaluated}}<li>{{criterion}} — {{name}}</li>
{{/notEvaluated}}</ul>
{{/hasNotEvaluated}}
<h2>{{t.statement.preparationHeading}}</h2>
<p>{{t.statement.preparedOn}} {{dates.preparation}}.</p>
{{#method}}<p>{{t.statement.method}}: {{.}}</p>
{{/method}}{{#dates.lastReview}}<p>{{t.statement.lastReviewed}} {{.}}.</p>
{{/dates.lastReview}}
<h2>{{t.statement.feedbackHeading}}</h2>
<p>{{t.statement.feedbackIntro}}</p>
<ul>
{{#feedback.email}}<li><a href="mailto:{{.}}">{{.}}</a></li>
{{/feedback.email}}{{#feedback.url}}<li><a href="{{.}}">{{.}}</a></li>
{{/feedback.url}}{{#feedback.phone}}<li>{{.}}</li>
{{/feedback.phone}}</ul>
<h2>{{t.statement.enforcementHeading}}</h2>
<p>{{t.statement.enforcementIntro}}</p>
<ul>
<li>{{enforcement.name}}</li>
{{#enforcement.address}}<li>{{.}}</li>
{{/enforcement.address}}{{#enforcement.email}}<li><a href="mailto:{{.}}">{{.}}</a></li>
{{/enforcement.email}}{{#enforcement.phone}}<li>{{.}}</li>
{{/enforcement.phone}}{{#enforcement.url}}<li><a href="{{.}}">{{.}}</a></li>
{{/enforcement.url}}</ul>
<footer>
<p>{{legal.act}}{{#legal.references}} · {{ref}}{{/legal.references}}</p>
<p>EN 301 549 v{{standards.en}} · WCAG {{standards.wcag}} · {{generatedBy}}</p>
</footer>
</main>
</body>
</html>

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rpops101/accessibility-statement/blob/main/packages/packs/schema/pack.schema.json",
  "title": "accessibility-statement jurisdiction pack metadata (pack.yaml)",
  "type": "object",
  "required": [
    "schemaVersion",
    "country",
    "name",
    "languages",
    "defaultLanguage",
    "legal",
    "enforcement",
    "quality"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "country": {
      "type": "string",
      "pattern": "^[a-z]{2}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2}(-[A-Za-z0-9-]+)?$"
      }
    },
    "defaultLanguage": {
      "type": "string",
      "pattern": "^[a-z]{2}(-[A-Za-z0-9-]+)?$"
    },
    "legal": {
      "type": "object",
      "required": [
        "act",
        "sources"
      ],
      "properties": {
        "act": {
          "type": "string",
          "minLength": 1
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      }
    },
    "enforcement": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "verified": {
          "type": "string",
          "format": "date"
        },
        "conciliation": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string"
            },
            "email": {
              "type": "string"
            },
            "phone": {
              "type": "string"
            },
            "address": {
              "type": "string"
            },
            "note": {
              "type": "string"
            }
          }
        }
      }
    },
    "deadlines": {
      "type": "object",
      "properties": {
        "enforceableSince": {
          "type": "string",
          "format": "date"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "quality": {
      "type": "string",
      "enum": [
        "bronze",
        "silver",
        "gold"
      ]
    },
    "maintainers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  }
}

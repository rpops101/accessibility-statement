{
  "name": "@accessibility-statement/packs",
  "version": "0.1.0",
  "description": "Per-country accessibility statement templates, translations, legal references and enforcement-body details for all EU member states. Data only.",
  "license": "MIT",
  "type": "module",
  "files": [
    "packs",
    "schema"
  ],
  "exports": {
    "./packs/": "./packs/",
    "./schema/": "./schema/",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"\"",
    "test": "node ../../scripts/run-tests.mjs test",
    "update-snapshots": "node --import tsx scripts/update-snapshots.ts",
    "gen-schema": "node scripts/gen-schema.mjs"
  },
  "devDependencies": {
    "@accessibility-statement/core": "*",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "accessibility-statement",
    "accessibility",
    "a11y",
    "eaa",
    "european-accessibility-act",
    "jurisdiction",
    "i18n",
    "compliance",
    "eu"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rpops101/accessibility-statement.git",
    "directory": "packages/packs"
  },
  "bugs": {
    "url": "https://github.com/rpops101/accessibility-statement/issues"
  },
  "homepage": "https://github.com/rpops101/accessibility-statement#readme"
}

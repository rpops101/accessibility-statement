{
  "name": "accessibility-statement-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Accessibility statement generator for the European Accessibility Act (monorepo)",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/packs",
    "packages/cli"
  ],
  "scripts": {
    "build": "npm run build -w @accessibility-statement/core -w @accessibility-statement/packs -w accessibility-statement && npm run gen-schemas",
    "cli": "node packages/cli/dist/main.js",
    "gen-schemas": "node scripts/gen-config-schema.mjs && npm run gen-schema -w @accessibility-statement/packs",
    "test": "npm run test -w @accessibility-statement/core -w @accessibility-statement/packs -w accessibility-statement",
    "lint": "tsc -p packages/core/tsconfig.json --noEmit && tsc -p packages/cli/tsconfig.json --noEmit",
    "format": "prettier --write \"packages/**/*.{ts,yaml,md}\" \"scripts/*.mjs\" \"*.md\"",
    "format:check": "prettier --check \"packages/**/*.{ts,yaml,md}\" \"scripts/*.mjs\" \"*.md\"",
    "render-corpus": "node scripts/render-corpus.mjs",
    "seed-issues": "node scripts/seed-issues.mjs",
    "check-pack-links": "node scripts/check-pack-links.mjs",
    "gen-demo": "node scripts/gen-demo.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rpops101/accessibility-statement.git"
  },
  "bugs": {
    "url": "https://github.com/rpops101/accessibility-statement/issues"
  },
  "homepage": "https://github.com/rpops101/accessibility-statement#readme"
}
